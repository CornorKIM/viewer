# Copy to .env and fill in. .env is git-ignored. Values come from the Vercel project "viewer".
# Host port for the viewer (docker compose)
VIEWER_PORT=20040

# --- Core (3D viewer data) ---
PG_PASSWORD=
# Leave empty to use the default DB server; "localhost" only if DB runs on this host
PG_HOST=
INFLUX_TOKEN=
# InfluxDB server. Docker on this host: http://sl-influxdb:8086 (empty = 175.193.55.102:8086)
INFLUX_URL=

# --- Login / API protection ---
AUTH_SECRET=
CRON_SECRET=
CDR_INGEST_SECRET=

# --- Daily KPI report mail (api/kpi-report) ---
RESEND_API_KEY=
KPI_REPORT_FROM=
KPI_REPORT_TO=
KR_HOLIDAY_API_KEY=

# --- Smart-factory log API keys per company (api/sf-log) ---
SF_LOG_KEY_A=
SF_LOG_KEY_B=
SF_LOG_KEY_C=
SF_LOG_KEY_D=
SF_LOG_DEFAULT_IP=
SF_LOG_IP_A=
SF_LOG_IP_B=
SF_LOG_IP_C=
SF_LOG_IP_D=

# --- Gyeonggi TP type-1 (CDR) ---
SF_LOG_KEY_TP1_CDR=
TP1_PASSWORD_CDR=
TP1_INFLUX_BUCKET_CDR=
TP1_INFLUX_TOPIC_CDR=
TP1_INFLUX_ORG=
TP1_LOG_IP_CDR=

# Comma-separated proxy IPs whose X-Forwarded-For is trusted (e.g. gateway nginx container IP)
TRUSTED_PROXIES=

# --- Daily 23:00 status mail (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# Gmail app password
SMTP_PASS=
# Recipients, comma-separated
SF_REPORT_TO=
# Link to the history screen put in the status mail (empty = https://twin.smartline.kr/sflog.html)
SF_REPORT_LINK=

# --- sf-daily service (business-day auto log sending + status mail; docker compose service sf-daily) ---
# true = send steps and the status mail; false = the service stays up and sends nothing
SF_DAILY_ENABLED=false
# Seconds between rounds, integer 10..60 (empty = 30)
SF_DAILY_TICK_SECONDS=
# KST time of the daily status mail, HH:MM (empty = 23:00)
SF_REPORT_AT=
# Holiday iCal URL (empty = Google "대한민국의 휴일" public calendar)
SF_HOLIDAY_CALENDAR_URL=
# Password of the dedicated sf-daily-db PostgreSQL (compose builds SF_DB_URL from it).
# Use URL-safe characters only (letters, digits, - _ .). Fixed at the DB's first start.
SF_DB_PASSWORD=

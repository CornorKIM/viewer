# 경기TP 유형1 로그 전송 설정 - 이 파일을 같은 폴더에 .env.tp1 로 복사해 값 입력 (.env* 는 git에 올라가지 않음)
PG_PASSWORD=
# 이 서버가 DB 서버와 같은 장비면 localhost
PG_HOST=
INFLUX_TOKEN=
# (주)CDR시스템 사업관리시스템 로그API 인증키
SF_LOG_KEY_TP1_CDR=
# (주)CDR시스템 센서 식별 (InfluxDB 버킷, topic 태그)
TP1_INFLUX_BUCKET_CDR=
TP1_INFLUX_TOPIC_CDR=
# (선택) InfluxDB org, 기본 dx
TP1_INFLUX_ORG=
# (선택) 데이터 등록 로그의 접속 IP. 비우면 DB 서버 IP
TP1_LOG_IP_CDR=
